  "favicon": "/favicon.svg",
  "logo": "/logo.svg",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "label": "GitHub",
        "href": "https://github.com/superserve-ai/superserve"
      },
      {
        "label": "Log in",
        "href": "https://console.superserve.ai/auth/signin/?utm_source=docs&utm_medium=navbar"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://console.superserve.ai/auth/signup/?utm_source=docs&utm_medium=navbar"
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "mcp", "add-mcp", "cursor", "vscode"]
  },
  "redirects": [
    { "source": "/sandbox/memory", "destination": "/sandbox/live-memory-resizing" },
    {
      "source": "/integrations/managed-agents/claude-managed-agents",
      "destination": "/integrations/agent-platforms/claude-managed-agents",
      "permanent": true
    },
    {
      "source": "/integrations/managed-agents/cursor-cloud-agents",
      "destination": "/integrations/agent-platforms/cursor-cloud-agents",
      "permanent": true
    },
    {
      "source": "/integrations/managed-agents/omnara",
      "destination": "/integrations/agent-platforms/omnara",
      "permanent": true
    },
    {
      "source": "/integrations/personal-agents/qm",
      "destination": "/integrations/agent-platforms/qm",
      "permanent": true
    },
    {
      "source": "/integrations/managed-agents",
      "destination": "/integrations/overview#agent-platforms",
      "permanent": true
    },
    {
      "source": "/integrations/managed-agents/:slug*",
      "destination": "/integrations/agent-platforms/:slug*",
      "permanent": true
    },
    {
      "source": "/integrations/virtual-filesystems/mesa",
      "destination": "/storage/archil"
    },
    {
      "source": "/storage/mesa",
      "destination": "/storage/archil"
    },
    {
      "source": "/integrations/virtual-filesystems/archil",
      "destination": "/storage/archil"
    }
