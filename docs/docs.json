{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Superserve",
  "colors": {
    "primary": "#B2FAB4",
    "light": "#B2FAB4",
    "dark": "#B2FAB4"
  },
  "fonts": {
    "heading": {
      "family": "Instrument Sans"
    },
    "body": {
      "family": "Instrument Sans"
    }
  },
  "background": {
    "color": {
      "dark": "#141414"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark-default"
      }
    }
