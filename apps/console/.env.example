SANDBOX_API_URL=
# Token for the default (use) control plane's /internal/signup/evaluate.
INTERNAL_API_TOKEN=
# Token for the usw control plane; configure alongside the usw cell.
INTERNAL_API_TOKEN_USWEST=
NEXT_PUBLIC_WEBSITE_URL=https://www.superserve.ai
# Canonical browser origin, required for YC confirmation; keep build/runtime equal.
# HTTPS or explicit HTTP localhost, 127.0.0.1, or [::1] with optional valid port.
NEXT_PUBLIC_APP_URL=

# Shared across website + console subdomains (e.g. .superserve.ai) so
# Supabase auth cookies and PostHog device_id cookies are accessible from both.
# Leave empty in local dev.
NEXT_PUBLIC_COOKIE_DOMAIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Data-plane origin for default-cell sandboxes (terminal, files, preview).
# URLs become <scheme>://boxd-<id>.<host>[:<port>]/… and websockets use wss/ws
# to match the scheme. Scheme is https (default) or http; port is optional.
NEXT_PUBLIC_SANDBOX_SCHEME=https
NEXT_PUBLIC_SANDBOX_HOST=sandbox.superserve.ai
NEXT_PUBLIC_SANDBOX_PORT=
# Secret used to derive per-user proxy API keys, generate with: openssl rand -base64 48
CONSOLE_PROXY_SECRET=
# Internal sandbox API token used by server-side platform support routes.
SANDBOX_INTERNAL_API_TOKEN=
SLACK_WEBHOOK_URL=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Email delivery: resend (default) or smtp. SMTP uses SMTP_HOST and SMTP_PORT
# (default 25) without auth. There is no fallback between transports.
# RESEND_FROM_ADDRESS is the sender for either transport.
EMAIL_TRANSPORT=resend
SMTP_HOST=
SMTP_PORT=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Superserve <team@console.superserve.ai>

# Domain whose Google-verified accounts are Superserve staff (default: superserve.ai)
STAFF_EMAIL_DOMAIN=superserve.ai

# Google Cloud reCAPTCHA Enterprise, front-door friction on signup. Leave all
# three empty to disable — verification fails open when unconfigured.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_API_KEY=
RECAPTCHA_PROJECT_ID=
# Also signs retry binding of verified email signup evidence at confirmation.
GOOGLE_SIGNUP_PROOF_SECRET=

# Fingerprint signup evaluation. The browser key is public; the secret key must
# remain server-only. Leave unset to disable observation without affecting signup.
NEXT_PUBLIC_FINGERPRINT_API_KEY=
NEXT_PUBLIC_FINGERPRINT_REGION=us
FINGERPRINT_SECRET_API_KEY=
# Override for EU/AP workspaces (for example https://eu.api.fpjs.io).
FINGERPRINT_SERVER_API_URL=https://api.fpjs.io

# Promotion producer credentials for the regional control plane. Use distinct
# server-only values; these must match each cell's scoped producer tokens.
PROMOTION_CAPTURE_TOKEN=
PROMOTION_ACCOUNT_TOKEN=
PROMOTION_ACCOUNT_TOKEN_USWEST=
# Ed25519 PKCS#8 PEM with actual newlines. The private key stays in Console;
# each backend receives only its raw 32-byte public key, standard-base64 encoded.
PROMOTION_ACCOUNT_PRIVATE_KEY=
# Required fixed UTC rollout boundary. Set once before deployment; never advance
# it on later releases. Pre-boundary accounts retain ordinary missing-evidence behavior.
PROMOTION_SIGNUP_EVIDENCE_SINCE=

# Cloudflare signup evaluation (observe-only; failures never affect signup).
# Runtime enable/disable uses the cloudflare_signup_observation feature flag.
# Keep these defaults until Ephemeral ID activation on the existing widget is confirmed.
CLOUDFLARE_SIGNUP_CONFIG_VERSION=v1
CLOUDFLARE_SIGNUP_CAPABILITIES=turnstile_free
# After confirmation, set both values in the effective console deployment:
# CLOUDFLARE_SIGNUP_CONFIG_VERSION=ss-560-ephemeral-v1
# CLOUDFLARE_SIGNUP_CAPABILITIES=turnstile_enterprise,ephemeral_id
# See docs/ss-468-cloudflare-evaluation.md for activation and expiry evidence.
# Optional Enterprise Turnstile observation challenge. This never replaces reCAPTCHA.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Server-only YC account-completion credential; match the control-plane cells.
# Use at least 32 random bytes, separate from capture/internal/operator credentials.
YC_CLAIM_CONSOLE_TOKEN=

# Optional server-only website origin for the YC verification link.
# HTTPS or explicit HTTP localhost, 127.0.0.1, or [::1] with optional valid port.
# Unset preserves production; invalid/empty values disable the link.
# YC_CLAIM_WEBSITE_URL=https://www.superserve.ai
